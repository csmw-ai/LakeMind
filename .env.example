# LakeMind 环境变量 — 复制为 .env 后修改
# 所有初始配置归口在此文件，models.yaml 通过 ${VAR} 引用

# ============ 镜像配置 ============
LAKEMIND_REGISTRY=ghcr.io/csmw-ai/lakemind
LAKEMIND_VERSION=latest
POSTGRES_AGE_VERSION=latest
PULL_POLICY=missing

# 自动激活所有 profile（ray + all），无需 --profile 参数
COMPOSE_PROFILES=ray,all

# ---- 第三方镜像 ----
SEAWEEDFS_IMAGE=chrislusf/seaweedfs:3.80
VALKEY_IMAGE=valkey/valkey:8.0.9
RAY_IMAGE=rayproject/ray:2.41.0-py312

# ============ 存储配置 ============
# ---- SeaweedFS (S3 对象存储) ----
SEAWEEFS_S3_PORT=8333
S3_ACCESS_KEY=admin
S3_SECRET_KEY=admin123456

# ---- PostgreSQL 16 (统一元数据) ----
PG_DB=lakemind
PG_USER=lakemind
PG_PASSWORD=lakemind_pass

# ============ Ray 配置 ============
RAY_HEAD_CPUS=4
RAY_WORKER_CPUS=4

# ============ LLM Provider 配置 ============
# 你的 LLM API provider。models.yaml 通过 ${MAAS_BASE_URL} / ${MAAS_API_KEY} 引用
# 常见 provider：
#   华为云 ModelArts:  base_url=https://api.modelarts-maas.com/openai/v1  type=openai
#   OpenAI:            base_url=https://api.openai.com/v1               type=openai
#   DeepSeek:          base_url=https://api.deepseek.com/v1             type=openai
#   Ollama (本地):      base_url=http://host.docker.internal:11434      type=ollama
# 启动后也可在 ControlCenter → ModelServing → Provider 页面动态增删改
MAAS_BASE_URL=https://api.modelarts-maas.com/openai/v1
MAAS_API_KEY=<your-llm-api-key>

# ============ 安全密钥 ============
# AES-256-GCM 主密钥，用于加密数据库中存储的租户密钥
# 生成方法: openssl rand -base64 32
# 注意: 生成后妥善保管，丢失将无法解密已存储的密钥
LAKEMIND_MASTER_KEY=<run: openssl rand -base64 32>

# Server REST API 认证令牌（Bearer token）
# 用于 Ray Job 回调 Server、meeting-agent 等外部调用 Server API
# 生成方法: openssl rand -hex 32
SERVER_API_KEY=<run: openssl rand -hex 32>

# ============ 控制平面 ============
LAKEMIND_V2_AUTH=1

# ============ 嵌入式引擎 ============
LANCE_DB_URI=lance:///data/lance
